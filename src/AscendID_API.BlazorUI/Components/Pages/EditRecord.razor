@page "/edit-record/{id:int}"
@rendermode InteractiveServer
@inject TempTestRecordService RecordService
@inject NavigationManager Navigation

<PageTitle>Edit Record</PageTitle>

<h1>Edit Temp Test Record</h1>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (existingRecord == null)
{
    <div class="alert alert-warning">Record not found.</div>
    <a href="/temp-test-records" class="btn btn-secondary">Back to List</a>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="@model" OnValidSubmit="HandleValidSubmit">
                <FluentValidationValidator />
                
                <div class="mb-3">
                    <label class="form-label">ID</label>
                    <input type="text" class="form-control" value="@existingRecord.Id" disabled />
                </div>

                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <InputText id="name" class="form-control" @bind-Value="model.Name" />
                    <ValidationMessage For="@(() => model.Name)" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <InputTextArea id="description" class="form-control" rows="4" @bind-Value="model.Description" />
                    <ValidationMessage For="@(() => model.Description)" />
                </div>

                @if (errorMessage != null)
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }

                @if (successMessage != null)
                {
                    <div class="alert alert-success">@successMessage</div>
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" disabled="@submitting">
                        @if (submitting)
                        {
                            <span>Updating...</span>
                        }
                        else
                        {
                            <span>Update Record</span>
                        }
                    </button>
                    <a href="/temp-test-records" class="btn btn-secondary ms-2">Cancel</a>
                </div>
            </EditForm>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Current Record Info</h5>
                </div>
                <div class="card-body">
                    <p><strong>Created:</strong> @existingRecord.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
                    <p><strong>Updated:</strong> @(existingRecord.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never")</p>
                    <p><strong>Status:</strong> @(existingRecord.IsActive ? "Active" : "Inactive")</p>
                </div>
            </div>
            <div class="alert alert-info mt-3">
                <h6>Shared Validation</h6>
                <p class="mb-0">
                    <small>
                        This form uses the same FluentValidation rules as the API,
                        defined in <code>UpdateTempTestRecordDtoValidator</code>.
                    </small>
                </p>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private TempTestRecordDto? existingRecord;
    private EditRecordModel model = new();
    private bool loading = true;
    private bool submitting = false;
    private string? errorMessage;
    private string? successMessage;

    private class EditRecordModel
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRecord();
    }

    private async Task LoadRecord()
    {
        loading = true;
        errorMessage = null;

        try
        {
            existingRecord = await RecordService.GetRecordByIdAsync(Id);
            
            if (existingRecord != null)
            {
                model.Name = existingRecord.Name;
                model.Description = existingRecord.Description;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading record: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task HandleValidSubmit()
    {
        submitting = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var dto = new UpdateTempTestRecordDto(model.Name, model.Description);
            await RecordService.UpdateRecordAsync(Id, dto);
            successMessage = "Record updated successfully!";
            
            // Navigate to list after a brief delay
            await Task.Delay(1500);
            Navigation.NavigateTo("/temp-test-records");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating record: {ex.Message}";
        }
        finally
        {
            submitting = false;
        }
    }
}
