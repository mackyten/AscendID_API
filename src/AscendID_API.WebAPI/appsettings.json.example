{
  "ConnectionStrings": {
    "DefaultConnection": "User Id=postgres;Password=YOUR_PASSWORD;Server=localhost;Port=5433;Database=ascendid_api"
  },
  "AdminUser": {
    "Email": "admin@yourdomain.com",
    "Password": "YourSecureAdminPassword123!"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG_FOR_SECURITY",
    "Issuer": "AscendID_API",
    "Audience": "AscendID_API_Users",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}